generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model sessions {
  token            String        @id @db.VarChar(255)
  userAgent        String        @db.Text
  generationDate   DateTime      @default(dbgenerated("(curtime())")) @db.Timestamp(0)
}

model projects {
  id               Int           @id @default(autoincrement())
  title            String        @db.Text
  imageUrl         String        @db.Text
  shortDescription String        @db.Text
  github           String        @db.Text
  public           Boolean       @db.TinyInt @default(false)
  dateOfCreation   DateTime      @default(dbgenerated("(curtime())")) @db.Timestamp(0)
}
